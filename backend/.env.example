# Tamargi.ai Backend Environment Variables Template
# Copy this file to .env and fill in your real credentials.

# Gemini API (Project Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# BYOK (Bring Your Own Key) Security & Rate Limiting
BYOK_ENCRYPTION_KEY=generate_a_secure_random_32_byte_secret_here
ALLOW_PROJECT_GEMINI_FALLBACK=false
CHAT_RATE_LIMIT_PER_MINUTE=15
CHAT_DAILY_LIMIT=200

# Supabase Auth & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# RAG Hyperparameters
EMBEDDING_MODEL=intfloat/multilingual-e5-base
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
DENSE_K=10
BM25_K=10
RRF_K=30
DENSE_WEIGHT=0.8
BM25_WEIGHT=0.8
CANDIDATE_K=10
FINAL_K=5

# Server Configuration
HOST=0.0.0.0
PORT=8000
